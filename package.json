{
  "name": "html-to-instagram-png-exporter",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality HTML-to-Instagram PNG Exporter",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,WEB\" -c \"cyan,magenta\" \"npm run dev -w @exporter/server\" \"npm run dev -w @exporter/web\"",
    "dev:server": "npm run dev -w @exporter/server",
    "dev:web": "npm run dev -w @exporter/web",
    "build": "npm run build -w @exporter/shared && npm run build -w @exporter/server && npm run build -w @exporter/web",
    "build:web": "npm run build -w @exporter/shared && npm run build -w @exporter/web",
    "build:server": "npm run build -w @exporter/shared && npm run build -w @exporter/server",
    "vercel-build": "npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
